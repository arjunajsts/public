          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

// 1. Fetch Employee ID dynamically from your CSV dataset configuration variable
def csvEmpId = vars.get(&quot;employee_id&quot;)?.trim()

if (csvEmpId == null || csvEmpId.isEmpty()) {
    log.error(&quot;CSV VARIABLE MISSING: &apos;employee_id&apos; could not be retrieved from the CSV config dataset.&quot;)
    return
}

def responseData = prev.getResponseDataAsString()
def resp = new JsonSlurper().parseText(responseData)
def ts = resp.timesheet_details
def allRows = ts?.task_details

if (allRows == null) {
    log.error(&quot;HTTP &quot; + prev.getResponseCode() + &quot;: No task_details found in payload.&quot;)
    return
}

def tasksToSubmit = new ArrayList()

// 2. Loop through all sections and collect every single available task ID from this fresh view
allRows.each { row -&gt;
    if (row.tasks) {
        row.tasks.each { task -&gt;
            if (task.id != null) {
                tasksToSubmit.add([
                    &quot;task_id&quot;: task.id.toInteger()
                ])
            }
        }
    }
}

if (tasksToSubmit.isEmpty()) {
    log.error(&quot;Failed to compile payload: No task IDs were found in the current response data.&quot;)
    return
}

def employeeId = csvEmpId.toInteger()

// 3. Construct the clean JSON payload format matching your exact UI verification layout
def finalSubmitPayload = [
    &quot;tasks&quot;       : tasksToSubmit,
    &quot;updated_by&quot;  : employeeId,
    &quot;submitted_by&quot;: employeeId
]

vars.put(&quot;submitPayload&quot;, JsonOutput.toJson(finalSubmitPayload))
log.info(&quot;Successfully compiled strict submitPayload with &quot; + tasksToSubmit.size() + &quot; entries for Employee: &quot; + employeeId)
</stringProp>
