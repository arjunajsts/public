            <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.*

def bu = vars.get(&quot;bu2&quot;)?.trim()
def wf = vars.get(&quot;wf2&quot;)?.trim()

def resp = new JsonSlurper().parseText(prev.getResponseDataAsString())
def ts   = resp.timesheet_details
def allRows = ts?.task_details

if (allRows == null) {
    log.error(&quot;HTTP &quot; + prev.getResponseCode() + &quot;: no task_details.&quot;)
    return
}

def rows = allRows.unique(false) { it.monthly_comments.taskline_id }
def task2Row = rows.find { r -&gt; r.business_unit.id.toString() == bu &amp;&amp; r.workflow.id.toString() == wf }
if (task2Row == null) {
    task2Row = rows ? rows[0] : null
}

if (task2Row == null) {
    log.error(&quot;No valid task rows available for Task 2.&quot;)
    return
}

vars.put(&quot;usedTasklines&quot;, task2Row.monthly_comments.taskline_id.toString())
def holidayList = resp.holidays ?: new ArrayList()
def holidays = holidayList.collect { it.holiday_date } as Set

def start = LocalDate.parse(task2Row.tasks[0].date_logged)
def endStr = vars.get(&quot;periodEnd&quot;)
def end = endStr ? LocalDate.parse(endStr) : start.withDayOfMonth(start.lengthOfMonth())

def tasks = new ArrayList()
for (LocalDate d = start; !d.isAfter(end); d = d.plusDays(1)) {
    boolean workDay = d.dayOfWeek.value &lt;= 5 &amp;&amp; !holidays.contains(d.toString())
    
    // Explicitly target the second week of the month (Days 8 to 14)
    int hoursToLog = (workDay &amp;&amp; d.getDayOfMonth() &gt;= 8 &amp;&amp; d.getDayOfMonth() &lt;= 14) ? 9 : 0
    
    def existing = task2Row.tasks.find { it.date_logged == d.toString() }
    
    if (hoursToLog &gt; 0 || existing?.id != null) {
        tasks.add([
            id                : existing?.id,
            task_name         : &quot;&quot;,
            description       : &quot;&quot;,
            comments          : &quot;&quot;,
            task_status       : &quot;SAVED&quot;,
            timesheet_id      : ts.timesheet_id,
            timesheet_group_id: task2Row.timesheet_group.id,
            business_unit_id  : task2Row.business_unit.id,
            workflow_id       : task2Row.workflow.id,
            taskline_id       : task2Row.monthly_comments.taskline_id,
            task_id           : existing?.id,
            date_logged       : d.toString(),
            hours_logged      : hoursToLog,
            approver_id       : task2Row.approver.id,
            is_overtime       : false,
            role_name         : &quot;&quot;,
            overtime_hours    : 0
        ])
    }
}

def monthly = [[
    bu_id             : task2Row.business_unit.id,
    wf_id             : task2Row.workflow.id,
    taskline_id       : task2Row.monthly_comments.taskline_id,
    timesheet_group_id: task2Row.timesheet_group.id,
    monthly_comment   : &quot;&quot;
]]

vars.put(&quot;savePayload_2&quot;, JsonOutput.toJson([tasks: tasks, monthly_comments: monthly]))
log.info(&quot;savePayload built for Task 2: &quot; + tasks.size() + &quot; entries.&quot;)
</stringProp>
