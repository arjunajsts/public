            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.*

def bu = vars.get(&quot;bu1&quot;)?.trim()
def wf = vars.get(&quot;wf1&quot;)?.trim()
def tg = vars.get(&quot;tg1&quot;)?.trim()

def resp = new JsonSlurper().parseText(prev.getResponseDataAsString())
def ts   = resp.timesheet_details
def allRows = ts?.task_details

if (allRows == null) {
    log.error(&quot;HTTP &quot; + prev.getResponseCode() + &quot;: no task_details.&quot;)
    return
}

// one row per taskline (avoids duplicates)
def rows = allRows.unique(false) { it.monthly_comments.taskline_id }
def task1Row = rows.find { r -&gt; r.business_unit.id.toString() == bu &amp;&amp; r.workflow.id.toString() == wf &amp;&amp; r.timesheet_group.id.toString() == tg }
if (task1Row == null) {
    task1Row = rows.find { r -&gt; r.business_unit.id.toString() == bu &amp;&amp; r.workflow.id.toString() == wf }
}
if (task1Row == null) {
    task1Row = rows ? rows[0] : null
}
if (task1Row == null) {
    log.error(&quot;No valid task rows available for Task 1.&quot;)
    return
}

def holidayList = resp.holidays ?: new ArrayList()
def holidays = holidayList.collect { it.holiday_date } as Set

def start = LocalDate.parse(task1Row.tasks[0].date_logged)
def endStr = vars.get(&quot;periodEnd&quot;)
def end = endStr ? LocalDate.parse(endStr) : start.withDayOfMonth(start.lengthOfMonth())

def tasks = new ArrayList()
for (LocalDate d = start; !d.isAfter(end); d = d.plusDays(1)) {
    boolean workDay = d.dayOfWeek.value &lt;= 5 &amp;&amp; !holidays.contains(d.toString())

    // First week: days 2 to 7 (Mon-Fri only)
    int hoursToLog = (workDay &amp;&amp; d.getDayOfMonth() &gt;= 2 &amp;&amp; d.getDayOfMonth() &lt;= 7) ? 9 : 0

    def existing = task1Row.tasks.find { it.date_logged == d.toString() }

    if (hoursToLog &gt; 0 || existing?.id != null) {
        tasks.add([
            id                : existing?.id,
            task_name         : &quot;&quot;,
            description       : &quot;&quot;,
            comments          : &quot;&quot;,
            task_status       : &quot;SAVED&quot;,
            timesheet_id      : ts.timesheet_id,
            timesheet_group_id: task1Row.timesheet_group.id,
            business_unit_id  : task1Row.business_unit.id,
            workflow_id       : task1Row.workflow.id,
            taskline_id       : task1Row.monthly_comments.taskline_id,
            task_id           : existing?.id,
            date_logged       : d.toString(),
            hours_logged      : hoursToLog,
            approver_id       : task1Row.approver.id,
            is_overtime       : false,
            role_name         : &quot;&quot;,
            overtime_hours    : 0
        ])
    }
}

def monthly = [[
    bu_id             : task1Row.business_unit.id,
    wf_id             : task1Row.workflow.id,
    taskline_id       : task1Row.monthly_comments.taskline_id,
    timesheet_group_id: task1Row.timesheet_group.id,
    monthly_comment   : &quot;&quot;
]]

vars.put(&quot;savePayload_1&quot;, JsonOutput.toJson([tasks: tasks, monthly_comments: monthly]))
log.info(&quot;savePayload built for Task 1: &quot; + tasks.size() + &quot; entries.&quot;)
</stringProp>
