          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def resp = new JsonSlurper().parseText(prev.getResponseDataAsString())
def rows = resp.timesheet_details?.task_details

if (!rows) {
    log.error(&quot;HTTP &quot; + prev.getResponseCode() + &quot;: no task_details. Response start: &quot; +
              prev.getResponseDataAsString().take(500))
    return
}

// every task row id from every task line
def taskList = rows.collectMany { r -&gt;
    r.tasks.collect { t -&gt; [task_id: t.id] }
}

// employee id comes from the response (differs per user)
def empId = rows[0].monthly_comments.employee_id

vars.put(&quot;submitPayload&quot;, JsonOutput.toJson([
    tasks       : taskList,
    updated_by  : empId,
    submitted_by: empId
]))

log.info(&quot;submitPayload built: &quot; + taskList.size() + &quot; task ids, employee &quot; + empId)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
