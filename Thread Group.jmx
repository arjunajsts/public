          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.*
import java.time.temporal.*

// Target columns for Task 1
def bu = vars.get(&quot;bu1&quot;)?.trim()
def wf = vars.get(&quot;wf1&quot;)?.trim()

def resp = new JsonSlurper().parseText(prev.getResponseDataAsString())
def ts   = resp.timesheet_details
def allRows = ts?.task_details

if (allRows == null) {
    log.error(&quot;HTTP &quot; + prev.getResponseCode() + &quot;: no task_details. Response start: &quot; +
              prev.getResponseDataAsString().take(500))
    return
}

// Drop duplicate rows based on taskline_id to establish unique entries
def rows = allRows.unique(false) { it.monthly_comments.taskline_id }

// Find the precise row matching Task 1&apos;s configuration (fallback to first row if no match)
def task1Row = rows.find { r -&gt; r.business_unit.id.toString() == bu &amp;&amp; r.workflow.id.toString() == wf }
if (task1Row == null) {
    log.warn(&quot;No response row matches CSV bu1=&quot; + bu + &quot; wf1=&quot; + wf + &quot;. Falling back to the first available row.&quot;)
    task1Row = rows ? rows[0] : null
}

if (task1Row == null) {
    log.error(&quot;No valid task rows available in response to process Task 1.&quot;)
    return
}

log.info(&quot;Task 1 mapped to taskline &quot; + task1Row.monthly_comments.taskline_id + 
         &quot; (bu &quot; + task1Row.business_unit.id + &quot;, wf &quot; + task1Row.workflow.id + &quot;)&quot;)

vars.put(&quot;usedTasklines&quot;, task1Row.monthly_comments.taskline_id.toString())

def holidays = (resp.holidays ?: []).collect { it.holiday_date } as Set

// Establish timeframes based on the response details
def start = LocalDate.parse(task1Row.tasks[0].date_logged)
def endStr = vars.get(&quot;periodEnd&quot;)
def end = endStr ? LocalDate.parse(endStr) : start.withDayOfMonth(start.lengthOfMonth())

def startWeek = start.get(IsoFields.WEEK_OF_WEEK_BASED_YEAR)

def tasks = []
for (LocalDate d = start; !d.isAfter(end); d = d.plusDays(1)) {
    boolean workDay = d.dayOfWeek.value &lt;= 5 &amp;&amp; !holidays.contains(d.toString())
    
    // Determine if the current day belongs to Week 1 (Task 1 execution window)
    int currentWeek = d.get(IsoFields.WEEK_OF_WEEK_BASED_YEAR)
    int weekDiff = currentWeek - startWeek
    if (weekDiff &lt; 0) weekDiff += 52 
    
    // Task 1 executes explicitly during the first week index (0)
    int hoursToLog = (workDay &amp;&amp; weekDiff == 0) ? 9 : 0
    
    def existing = task1Row.tasks.find { it.date_logged == d.toString() }
    
    if (hoursToLog &gt; 0 || existing?.id != null) {
        tasks &lt;&lt; [
            id                : existing?.id,
            task_name         : &quot;&quot;,
            description       : &quot;&quot;,
            comments          : &quot;&quot;,
            task_status       : &quot;SAVED&quot;,
            timesheet_id      : ts.timesheet_id,
            timesheet_group_id: task1Row.timesheet_group.id,
            business_unit_id  : task1Row.business_unit.id,
            workflow_id       : task1Row.workflow.id,
            taskline_id       : task1Row.monthly_comments.taskline_id,
            task_id           : existing?.id,
            date_logged       : d.toString(),
            hours_logged      : hoursToLog,
            approver_id       : task1Row.approver.id,
            is_overtime       : false,
            role_name         : &quot;&quot;,
            overtime_hours    : 0
        ]
    }
}

def monthly = [[
    bu_id             : task1Row.business_unit.id,
    wf_id             : task1Row.workflow.id,
    taskline_id       : task1Row.monthly_comments.taskline_id,
    timesheet_group_id: task1Row.timesheet_group.id,
    monthly_comment   : &quot;&quot;
]]

vars.put(&quot;savePayload&quot;, JsonOutput.toJson([tasks: tasks, monthly_comments: monthly]))
log.info(&quot;savePayload built for Task 1: &quot; + tasks.size() + &quot; task entries generated.&quot;)

// =========================================================================
// SAVED VARIABLES EXPORTS FOR SUBSEQUENT ACTIONS
// =========================================================================
vars.put(&quot;extractedTimesheetId&quot;, ts.timesheet_id.toString())
vars.put(&quot;extractedEmployeeId&quot;, (ts.employee_id ?: 3109).toString())
vars.put(&quot;extractedBuId&quot;, task1Row.business_unit.id.toString())
vars.put(&quot;extractedWfId&quot;, task1Row.workflow.id.toString())
vars.put(&quot;extractedGroupId&quot;, task1Row.timesheet_group.id.toString())
vars.put(&quot;extractedApproverId&quot;, task1Row.approver.id.toString())
vars.put(&quot;extractedStartDate&quot;, start.toString())
vars.put(&quot;extractedEndDate&quot;, end.toString())
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
